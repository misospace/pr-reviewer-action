{
  "fixture": "tool-budget-tiers",
  "contract": "tool-request-budget/v1",
  "description": "#701 tier-aware native tool-loop request budget: the effective budget follows the review route (primary 8, smart 16, escalated 20), explicit values are bounded to 1..20, and SMART_TOOL_MAX_REQUESTS outranks TOOL_MAX_REQUESTS on smart/escalated runs. Each case carries the env the production harness subprocess would see and the expected (route, budget) both the v2 harness resolver and the v3 port must produce. #702 extends each expectation with the budget source (smart-override | explicit | tier-default) so the provenance of the ceiling is pinned across the migration too.",
  "cases": [
    {
      "name": "primary-default",
      "tier": "primary",
      "env": {},
      "expected": {
        "route": "primary",
        "budget": 8,
        "source": "tier-default"
      }
    },
    {
      "name": "routed-smart-profile",
      "tier": "primary",
      "env": {
        "REVIEW_CONTEXT_PROFILE": "smart"
      },
      "expected": {
        "route": "smart",
        "budget": 16,
        "source": "tier-default"
      }
    },
    {
      "name": "smart-tier-default",
      "tier": "smart",
      "env": {},
      "expected": {
        "route": "smart",
        "budget": 16,
        "source": "tier-default"
      }
    },
    {
      "name": "escalated-default",
      "tier": "smart",
      "env": {
        "TOOL_ESCALATION": "true"
      },
      "expected": {
        "route": "escalated",
        "budget": 20,
        "source": "tier-default"
      }
    },
    {
      "name": "escalation-wins-over-profile",
      "tier": "smart",
      "env": {
        "REVIEW_CONTEXT_PROFILE": "smart",
        "TOOL_ESCALATION": "true"
      },
      "expected": {
        "route": "escalated",
        "budget": 20,
        "source": "tier-default"
      }
    },
    {
      "name": "explicit-overrides-primary",
      "tier": "primary",
      "env": {
        "TOOL_MAX_REQUESTS": "5"
      },
      "expected": {
        "route": "primary",
        "budget": 5,
        "source": "explicit"
      }
    },
    {
      "name": "explicit-overrides-smart",
      "tier": "smart",
      "env": {
        "TOOL_MAX_REQUESTS": "5"
      },
      "expected": {
        "route": "smart",
        "budget": 5,
        "source": "explicit"
      }
    },
    {
      "name": "explicit-overrides-escalated",
      "tier": "smart",
      "env": {
        "TOOL_MAX_REQUESTS": "5",
        "TOOL_ESCALATION": "true"
      },
      "expected": {
        "route": "escalated",
        "budget": 5,
        "source": "explicit"
      }
    },
    {
      "name": "hard-ceiling-clamps-high",
      "tier": "primary",
      "env": {
        "TOOL_MAX_REQUESTS": "99"
      },
      "expected": {
        "route": "primary",
        "budget": 20,
        "source": "explicit"
      }
    },
    {
      "name": "floor-clamps-zero",
      "tier": "primary",
      "env": {
        "TOOL_MAX_REQUESTS": "0"
      },
      "expected": {
        "route": "primary",
        "budget": 1,
        "source": "explicit"
      }
    },
    {
      "name": "smart-override-precedence",
      "tier": "smart",
      "env": {
        "SMART_TOOL_MAX_REQUESTS": "10",
        "TOOL_MAX_REQUESTS": "3"
      },
      "expected": {
        "route": "smart",
        "budget": 10,
        "source": "smart-override"
      }
    },
    {
      "name": "escalated-override-precedence",
      "tier": "smart",
      "env": {
        "SMART_TOOL_MAX_REQUESTS": "10",
        "TOOL_MAX_REQUESTS": "3",
        "TOOL_ESCALATION": "true"
      },
      "expected": {
        "route": "escalated",
        "budget": 10,
        "source": "smart-override"
      }
    },
    {
      "name": "smart-override-ignored-on-primary",
      "tier": "primary",
      "env": {
        "SMART_TOOL_MAX_REQUESTS": "10"
      },
      "expected": {
        "route": "primary",
        "budget": 8,
        "source": "tier-default"
      }
    },
    {
      "name": "invalid-explicit-falls-to-tier-default",
      "tier": "smart",
      "env": {
        "TOOL_MAX_REQUESTS": "abc"
      },
      "expected": {
        "route": "smart",
        "budget": 16,
        "source": "tier-default"
      }
    },
    {
      "name": "invalid-smart-override-falls-to-explicit",
      "tier": "smart",
      "env": {
        "SMART_TOOL_MAX_REQUESTS": "abc",
        "TOOL_MAX_REQUESTS": "7"
      },
      "expected": {
        "route": "smart",
        "budget": 7,
        "source": "explicit"
      }
    },
    {
      "name": "invalid-both-fall-to-tier-default",
      "tier": "smart",
      "env": {
        "SMART_TOOL_MAX_REQUESTS": "abc",
        "TOOL_MAX_REQUESTS": "abc"
      },
      "expected": {
        "route": "smart",
        "budget": 16,
        "source": "tier-default"
      }
    },
    {
      "name": "primary-override-precedence",
      "tier": "primary",
      "env": {
        "PRIMARY_TOOL_MAX_REQUESTS": "12",
        "TOOL_MAX_REQUESTS": "3"
      },
      "expected": {
        "route": "primary",
        "budget": 12,
        "source": "primary-override"
      }
    },
    {
      "name": "primary-override-ignored-on-smart",
      "tier": "smart",
      "env": {
        "PRIMARY_TOOL_MAX_REQUESTS": "12"
      },
      "expected": {
        "route": "smart",
        "budget": 16,
        "source": "tier-default"
      }
    },
    {
      "name": "invalid-primary-override-falls-to-explicit",
      "tier": "primary",
      "env": {
        "PRIMARY_TOOL_MAX_REQUESTS": "abc",
        "TOOL_MAX_REQUESTS": "7"
      },
      "expected": {
        "route": "primary",
        "budget": 7,
        "source": "explicit"
      }
    }
  ]
}
