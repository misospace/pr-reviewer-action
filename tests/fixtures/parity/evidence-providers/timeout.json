{
  "fixture": "timeout",
  "description": "A provider that outlives timeout_sec: status timeout, exit_code None, partial output kept.",
  "config": {
    "providers": [
      {
        "id": "slow",
        "command": "printf 'partial before timeout\\n'; sleep 6",
        "timeout_sec": 1
      },
      {
        "id": "fast",
        "command": [
          "printf",
          "done"
        ]
      }
    ]
  },
  "env": {
    "EVIDENCE_PROVIDERS_FILE": "providers.json"
  }
}
