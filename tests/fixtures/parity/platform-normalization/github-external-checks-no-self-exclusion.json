{
  "fixture": "github-external-checks-no-self-exclusion",
  "description": "Without GITHUB_RUN_ID nothing is self-excluded by run, and CI_STATUS_CONTEXT defaults to pr-reviewer-action.",
  "platform": "github",
  "repo": "o/r",
  "pr_number": 7,
  "routes": [
    {
      "match": "repos/o/r/commits/0123456789abcdef0123456789abcdef01234567/check-runs?per_page=100",
      "body": {
        "total_count": 1,
        "check_runs": [
          {
            "id": 4242,
            "name": "self job",
            "status": "in_progress",
            "conclusion": null,
            "html_url": "https://github.com/o/r/actions/runs/4242/job/42420",
            "details_url": "https://github.com/o/r/actions/runs/4242/job/42420"
          }
        ]
      }
    },
    {
      "match": "repos/o/r/commits/0123456789abcdef0123456789abcdef01234567/status",
      "body": {
        "state": "pending",
        "total_count": 2,
        "statuses": [
          {
            "context": "pr-reviewer-action",
            "state": "pending"
          },
          {
            "context": "build",
            "state": "success"
          }
        ]
      }
    }
  ],
  "calls": [
    {
      "op": "external-checks",
      "sha": "0123456789abcdef0123456789abcdef01234567",
      "expected": {
        "text": "[{\"name\":\"self job\",\"state\":\"pending\"},{\"name\":\"build\",\"state\":\"success\"}]"
      }
    }
  ],
  "expected_requests": [
    "GET https://api.github.com/repos/o/r/commits/0123456789abcdef0123456789abcdef01234567/check-runs?per_page=100 auth=1",
    "GET https://api.github.com/repos/o/r/commits/0123456789abcdef0123456789abcdef01234567/status auth=1"
  ]
}
