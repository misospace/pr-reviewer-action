{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "pr-reviewer chart values",
  "type": "object",
  "additionalProperties": false,
  "required": ["controller", "workerExecutor"],
  "properties": {
    "webhook": { "type": "object", "additionalProperties": false, "properties": { "enabled": { "type": "boolean" }, "path": { "type": "string", "pattern": "^/[^\\s?#]*$", "description": "Absolute request path forge deliveries POST to (default /hook; Gitea/GitLab set their canonical /webhooks/<forge> path)." }, "existingSecret": { "type": "string" }, "secret": { "type": "string" } } },
    "dashboard": { "type": "object", "additionalProperties": false, "properties": { "enabled": { "type": "boolean" }, "existingSecret": { "type": "string" }, "secret": { "type": "string" } } },
    "route": { "type": "object", "additionalProperties": false, "properties": { "enabled": { "type": "boolean" }, "hostnames": { "type": "array", "items": { "type": "string" } }, "parentRefs": { "type": "array", "items": { "type": "object", "additionalProperties": true } }, "raw": { "type": "object", "additionalProperties": true } } },
    "monitoring": { "type": "object", "additionalProperties": false, "properties": { "serviceMonitor": { "type": "object", "additionalProperties": false, "properties": { "enabled": { "type": "boolean" } } } } },
    "common": {
      "type": "object",
      "description": "Values Helm merges in from the bjw-s common library dependency; operators configure the library through controller/global, not here."
    },
    "controller": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "instanceConfig": { "type": "string" },
        "instanceConfigExistingSecret": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string" },
            "key": { "type": "string" }
          }
        },
        "controlPlaneUrl": { "type": "string" },
        "controlPlaneUrlExistingSecret": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string" },
            "key": { "type": "string" }
          }
        },
        "persistence": {
          "type": "object",
          "description": "runs and workspace-cache define standard shared storage once; mappings and PVC names derive from these entries.",
          "additionalProperties": true
        },
        "paths": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "durableStateDir": { "type": "string" },
            "runsRoot": { "type": "string" },
            "workspaceCacheRoot": { "type": "string" }
          }
        },
        "webhook": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "secret": { "type": "string" },
            "existingSecret": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string" },
                "key": { "type": "string" }
              }
            }
          }
        },
        "admin": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "token": { "type": "string" },
            "dashboard": { "type": "boolean" },
            "auth": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mode": { "enum": ["token", "oidc"] },
                "oidc": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "issuer": { "type": "string" },
                    "clientId": { "type": "string" },
                    "redirectBase": { "type": "string" },
                    "allowedSubjects": { "type": "array", "items": { "type": "string" } },
                    "allowedEmails": { "type": "array", "items": { "type": "string" } },
                    "allowedGroups": { "type": "array", "items": { "type": "string" } },
                    "sessionTtlMinutes": { "type": "integer", "minimum": 5, "maximum": 1440 },
                    "clientSecret": { "type": "string" },
                    "existingSecret": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": { "name": { "type": "string" }, "key": { "type": "string" } }
                    }
                  }
                }
              }
            },
            "existingSecret": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string" },
                "key": { "type": "string" }
              }
            }
          }
        },
        "reconcile": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "intervalMs": { "type": "integer", "minimum": 50 },
            "repos": {
              "type": "array",
              "items": { "type": "string" }
            },
            "githubInstallationId": { "type": "string" }
          }
        },
        "forgeAuth": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "platform": { "enum": ["github", "forgejo"] },
            "github": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "appId": { "type": "string" },
                "appPrivateKey": { "type": "string" },
                "appPrivateKeyExistingSecret": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "name": { "type": "string" },
                    "key": { "type": "string" }
                  }
                }
              }
            },
            "forgejo": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "token": { "type": "string" },
                "existingSecret": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "name": { "type": "string" },
                    "key": { "type": "string" }
                  }
                }
              }
            }
          }
        },
        "credentials": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "value": { "type": "string" },
              "existingSecret": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": { "type": "string" },
                  "key": { "type": "string" }
                }
              }
            }
          }
        },
        "followUp": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "model": { "type": "string" },
            "mentions": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "env": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string" }
            },
            "additionalProperties": true
          }
        }
      }
    },
    "workerExecutor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["disabled", "kubernetes"] },
        "namespace": { "type": "string" },
        "serviceAccount": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "create": { "type": "boolean" },
            "name": { "type": "string" }
          }
        },
        "rbac": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "create": { "type": "boolean" }
          }
        },
        "image": {
          "type": "object",
          "description": "Authoritative Kubernetes worker image default passed to the controller; the instance profile may override it.",
          "additionalProperties": false,
          "properties": {
            "repository": { "type": "string", "description": "Worker image repository." },
            "tag": { "type": "string", "description": "Image tag; empty defaults to Chart.appVersion." },
            "digest": { "type": "string", "description": "Optional exact-byte pin in sha256:<64 lowercase hex> form." }
          }
        },
        "resources": {
          "type": "object",
          "description": "Authoritative Kubernetes worker resource defaults passed to the controller; profile resources override this whole block.",
          "additionalProperties": false,
          "required": ["requests", "limits"],
          "properties": {
            "requests": {
              "type": "object",
              "additionalProperties": false,
              "required": ["cpu", "memory"],
              "properties": {
                "cpu": { "type": "string", "maxLength": 32, "pattern": "^[0-9]+(\\.[0-9]+)?(m|k|M|G|Ki|Mi|Gi|Ti)?$" },
                "memory": { "type": "string", "maxLength": 32, "pattern": "^[0-9]+(\\.[0-9]+)?(m|k|M|G|Ki|Mi|Gi|Ti)?$" }
              }
            },
            "limits": {
              "type": "object",
              "additionalProperties": false,
              "required": ["cpu", "memory"],
              "properties": {
                "cpu": { "type": "string", "maxLength": 32, "pattern": "^[0-9]+(\\.[0-9]+)?(m|k|M|G|Ki|Mi|Gi|Ti)?$" },
                "memory": { "type": "string", "maxLength": 32, "pattern": "^[0-9]+(\\.[0-9]+)?(m|k|M|G|Ki|Mi|Gi|Ti)?$" }
              }
            }
          }
        },
        "ttlSecondsAfterFinished": { "type": "integer", "minimum": 1, "maximum": 604800, "description": "Authoritative worker Job cleanup TTL default; an explicit instance profile value wins." },
        "volumeClaims": {
          "type": "array",
          "description": "Additional non-standard worker claims only. Standard runs and workspace-cache claims derive from controller.persistence.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "size"],
            "properties": {
              "name": { "type": "string" },
              "size": { "type": "string" },
              "storageClass": { "type": "string" }
            }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "additionalIngress": {
          "type": "array",
          "items": { "type": "object", "additionalProperties": true }
        },
        "additionalEgress": {
          "type": "array",
          "items": { "type": "object", "additionalProperties": true }
        },
        "workerAdditionalEgress": {
          "type": "array",
          "items": { "type": "object", "additionalProperties": true }
        }
      }
    },
    "serviceMonitor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "interval": { "type": "string" },
        "port": { "type": ["integer", "null"], "minimum": 1, "maximum": 65535 },
        "path": { "type": "string" },
        "labels": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "global": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
