# Helm 4 applies .helmignore when READING a chart directory, not only when
# packaging it. The helm dependency-build artifacts must therefore stay
# loadable here: ignoring them makes the packaged bjw-s common dependency
# invisible at render time (no loader templates found). They are kept out
# of git instead, via the repository .gitignore entries for this chart.
*.swp
*.bak
*.tmp
*.orig
.DS_Store
