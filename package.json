{
  "name": "pr-reviewer-action-v3-runtime",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "node scripts/generate-v3-contract.mjs && tsc --noEmit",
    "test": "node scripts/generate-v3-contract.mjs && tsc -p tsconfig.test.json && node --test .test-build/tests-v3/*.test.js",
    "build": "node scripts/generate-v3-contract.mjs && node scripts/build-v3.mjs",
    "check:bundle": "npm run build && git diff --exit-code HEAD -- dist"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "esbuild": "0.25.5",
    "typescript": "5.8.3",
    "yaml": "2.9.1"
  }
}
