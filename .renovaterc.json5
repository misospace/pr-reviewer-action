{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["github>misospace/renovate-config"],
  // Configure pip-compile to manage requirements.in → requirements.txt.
  "pip-compile": {
    fileMatch: ["(^|/)requirements\\.txt$"],
  },
  // Disable plain pip_requirements manager to avoid conflicting with pip-compile.
  "pip_requirements": {
    enabled: false,
  },
}
